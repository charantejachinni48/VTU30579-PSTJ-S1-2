import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        // Read the number of lines
        int n = scan.nextInt();
        
        // Create an ArrayList of ArrayLists to store the integers for each line
        ArrayList<ArrayList<Integer>> lines = new ArrayList<>();
        
        for (int i = 0; i < n; i++) {
            int d = scan.nextInt();
            ArrayList<Integer> row = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                row.add(scan.nextInt());
            }
            lines.add(row);
        }
        
        // Read the number of queries
        int q = scan.nextInt();
        
        for (int i = 0; i < q; i++) {
            int x = scan.nextInt(); // line number
            int y = scan.nextInt(); // position on that line
            
            // Convert 1-based indexing from the problem to 0-based indexing in Java
            int lineIdx = x - 1;
            int posIdx = y - 1;
            
            // Check if the line and position exist
            if (lineIdx >= 0 && lineIdx < lines.size() && 
                posIdx >= 0 && posIdx < lines.get(lineIdx).size()) {
                System.out.println(lines.get(lineIdx).get(posIdx));
            } else {
                System.out.println("ERROR!");
            }
        }
        
        scan.close();
    }
}
